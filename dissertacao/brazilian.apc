\fi
\renewcommand{\APACmonth}[1]{\ifcase #1\or janeiro\or fevereiro\or março\or abril\or maio\or junho\or julho\or agosto\or setembro\or outubro\or novembro\or dezembro\else {#1}\fi}%
\renewcommand{\APACrefYearMonthDay}[3]{%
  {\BBOP}{#1}%
  \ifx\@empty#2\@empty
    \ifx\@empty#3\@empty
    \else
      \unskip, {#3}%
    \fi
  \else
    \unskip, {#2}%
    \ifx\@empty#3\@empty
    \else
      \unskip~{#3}%
    \fi
  \fi
  {\BBCP}%
}%
\APACrestoreAtCode
