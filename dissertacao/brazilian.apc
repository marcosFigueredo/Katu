\ProvidesFile{brazilian.apc}
  [2026/06/25 v1.0 Brazilian Portuguese apacite language file for classPPGMSB]
\edef\APACrestoreAtCode{%
  \catcode`@=\the\catcode`@\relax
}%
\makeatletter
